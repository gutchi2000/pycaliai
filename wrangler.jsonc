{
  // Cloudflare Workers — pycaliai.com
  //   site/ を静的配信 (ASSETS) + worker/index.js が /api/soudan（相談AI, 2026-11-03）を処理。
  //   デプロイは sync-hf-umami.ps1 の `npx wrangler deploy`（Workers Builds は 2026-08-17 以降発火せず、ローカルから直接 upload）。
  //   秘密: ANTHROPIC_API_KEY は `npx wrangler secret put ANTHROPIC_API_KEY`（git には入れない）。
  "name": "pycaliai",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/kaiko.xml"]
  },
  "kv_namespaces": [
    { "binding": "SOUDAN_KV", "id": "cdc7e8c706bb4875b2490a63f13b8c33" }
  ],
  "vars": {
    // 相談AI の守り（ユーザー承認 2026-11-03: Sonnet、全体 1 日 150 問まで、超えたら Haiku）
    "SOUDAN_MODEL": "claude-sonnet-5-5",
    "SOUDAN_FALLBACK_MODEL": "claude-haiku-5-5",
    "SOUDAN_DAILY_SONNET": "150",
    "SOUDAN_DAILY_HARD": "600",
    "SOUDAN_PER_IP_DAY": "30",
    "SOUDAN_MONTH_USD_CAP": "90",
    // 回顧記事（2026-11-04）: 1 レース 1 回だけ生成して KV に永続。1 日の生成上限と、相談AI と共通の月額上限
    "KAIKO_MODEL": "claude-sonnet-5-5",
    "KAIKO_DAILY_GEN": "150"
  },
  // 月曜 03:00 JST (= 日曜 18:00 UTC): Phase C 後の直近 2 開催日の回顧を埋める（ページを開いた人の端末からも lazy 生成される）
  // 土日 05:00 JST (= 金土 20:00 UTC): 結果待ちの開催日の「今日の見どころ」を埋める（Phase A が未実行でも出走表が公開済みなら生成）
  "triggers": { "crons": ["0 18 * * SUN", "0 20 * * FRI,SAT"] },
  "observability": { "enabled": true }
}
