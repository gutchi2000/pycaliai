  "method": "serve_history_feats._HistoryIndex.resolve()による名前ベース解決(このステップのみ)、複数走を持つ2026馬をサンプリングし日付間隔30日以上のギャップの経歴内位置を分類",
  "n_horses_sampled": 300,
  "position_distribution": {
   "oldest_gap": 166,
   "middle_gap": 38,
   "latest_gap": 73,
   "no_gap_detected": 23
  }
 },
 "production_consumers": [
  {
   "consumer": "serve_history_feats.py: fill_history_features()/_HistoryIndex/rolling_rate()",
